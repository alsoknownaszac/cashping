// Cashping Prisma schema.
//
// Step 5 of the build sequence: the datasource + generator below were written
// by `npx prisma init`, plus the first two models. Everything else is added by
// the module that needs it, so each migration stays tied to the feature that
// introduced it.
//
// Two things Prisma 7 changed that are worth knowing before editing this file:
//   1. The client is generated into `src/generated/prisma` (an explicit
//      `output` is now mandatory, and it has to sit under `src/` because
//      `nest build` compiles `src/` only). That directory is gitignored, so run
//      `npx prisma generate` after a fresh clone and in CI/Docker before build.
//   2. There is no `url = env("DATABASE_URL")` here. Prisma 7 reads the
//      datasource url from `prisma7.config.ts` instead.
//
// Column names are snake_case via @map/@@map. That is the Postgres convention
// and it keeps the raw reconciliation SQL in the ledger module (Steps 31-32)
// readable without quoting every identifier.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A Cashping end user.
///
/// Registration is phone-first: the row is created in PENDING_VERIFICATION as
/// soon as an OTP is issued, and the profile fields are filled in during
/// onboarding, which is why `handle` and `displayName` are nullable. `handle` is
/// the recipient identifier used for payments, so it is unique.
///
/// `phoneNumber` holds strict E.164 only (normalized by
/// `src/common/phone/phone-number.ts` before every read and write). Uniqueness
/// is only meaningful if there is one spelling per number: `024 123 4567`,
/// `+233241234567` and `2330241234567` all reach the column as `+233241234567`,
/// which is why normalization happens before the lookup rather than after.
///
/// `phoneVerifiedAt` is the timestamp Day 2 keys off - Stellar account
/// provisioning triggers on it - so it is set in the same write that flips the
/// status to ACTIVE, and never cleared.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  phoneNumber     String     @unique @map("phone_number")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  handle          String?    @unique
  displayName     String?    @map("display_name")
  /// Nullable: MVP registration is OTP-only, so a user has no password until
  /// (and unless) password login is added. A non-null value is always a hash.
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(PENDING_VERIFICATION)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  otpVerifications OtpVerification[]
  refreshTokens    RefreshToken[]
  stellarAccount   StellarAccount?

  @@map("users")
}

/// One SMS one-time password issued to a user.
///
/// `codeHash` holds a hash, never the OTP itself - an OTP is a bearer
/// credential, so a database leak must not hand over live codes. `consumedAt`
/// makes a code single-use, `attempts` lets the verify path lock out after
/// repeated wrong guesses, and `expiresAt` turns the expired-OTP edge case
/// (Days 6-7) into a timestamp comparison rather than a cleanup job.
model OtpVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Supports "latest OTP for this user" lookups and per-user rate limiting.
  @@index([userId, createdAt])
  @@map("otp_verifications")
}

/// One issued refresh token (Step 16).
///
/// The counterpart to the access token, and the reason the pair exists: an access
/// token is a signed JWT the API verifies without a database read, which is also why
/// it cannot be withdrawn before it expires (a 15-minute life is the whole
/// mitigation). A refresh token makes the opposite trade - it is opaque, stored
/// here, and checked against a row, so it *can* be revoked, rotated and audited.
///
/// `tokenHash` holds a SHA-256 digest, never the token: a refresh token is a bearer
/// credential with a 30-day life, so a leaked database must not hand over working
/// sessions. The digest is unsalted on purpose - the input is 256 bits of CSPRNG
/// output, so unlike a 6-digit OTP there is nothing to brute-force, and a salted
/// hash would have to be looked up by something other than its index.
///
/// `revokedAt` is what makes rotation real: refreshing marks the token that was
/// presented and issues a new one, and a token that shows up again after that (a
/// stolen copy, or a replay) is evidence the family is compromised - which
/// `TokenService` treats as a reason to revoke every live token for the user.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Supports "every live token for this user", which is what reuse detection -
  /// and an eventual "sign out everywhere" - both need.
  @@index([userId, createdAt])
  @@map("refresh_tokens")
}

/// A user's Stellar account, and the only place key material lives (Step 18).
///
/// `userId` is unique because MVP derives exactly one account per user, once the
/// phone number is verified (Step 19). A second account is a multi-wallet product
/// decision, so it should take a migration rather than be silently allowed by the
/// schema.
///
/// `encryptedSecretKey` never holds a secret key. It holds the `cp-kms-1`
/// envelope: a per-account data key wrapped by the KMS master key, plus the seed
/// encrypted with that data key under AES-256-GCM. The column is useless without a
/// KMS `Decrypt` call, which is the property the Step 18 audit checks by reading
/// this table directly.
///
/// `dataKeyArn` records the master key that wrapped *this* row's data key. KMS
/// keys are regional and a key is referenced by an ARN, so a row must not have to
/// guess which key opens it - that reference is also what a future re-wrap
/// (`ReEncrypt`) or an audited rotation needs. No key id, wrapping key or data key
/// is stored in the clear anywhere.
///
/// `publicKey` is stored because it is what Horizon and every payment reference,
/// and it is public by definition. It is unique on the network, so a collision
/// here means something generated the same key twice - worth failing on.
///
/// The relation is `Restrict`, deliberately unlike the `Cascade` the auth models
/// use: deleting a user must not destroy sealed key material or silently orphan a
/// funded Stellar account, so deletion has to be a deliberate, audited act that
/// deals with the account first. `onDelete: Restrict` is what makes that the
/// only option.
model StellarAccount {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  publicKey          String   @unique @map("public_key")
  /// The `cp-kms-1` envelope (see `src/wallet/custody/secret-envelope.ts`).
  encryptedSecretKey String   @map("encrypted_secret_key")
  dataKeyArn         String   @map("data_key_arn")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("stellar_accounts")
}

/// Account lifecycle.
///
/// `PENDING_VERIFICATION` is the state registration creates: the row exists and
/// an OTP has been issued, but the phone number is unproven. Verification moves
/// it to ACTIVE (Step 14). SUSPENDED exists from the start because freezing an
/// account is a compliance action, not something to bolt on later.
///
/// The default is deliberately PENDING_VERIFICATION rather than ACTIVE: a user
/// created by any path that forgets to prove the number is created locked, which
/// fails closed.
enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}
