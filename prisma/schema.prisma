// Cashping Prisma schema.
//
// Step 5 of the build sequence: the datasource + generator below were written
// by `npx prisma init`, plus the first two models. Everything else is added by
// the module that needs it, so each migration stays tied to the feature that
// introduced it.
//
// Two things Prisma 7 changed that are worth knowing before editing this file:
//   1. The client is generated into `src/generated/prisma` (an explicit
//      `output` is now mandatory, and it has to sit under `src/` because
//      `nest build` compiles `src/` only). That directory is gitignored, so run
//      `npx prisma generate` after a fresh clone and in CI/Docker before build.
//   2. There is no `url = env("DATABASE_URL")` here. Prisma 7 reads the
//      datasource url from `prisma7.config.ts` instead.
//
// Column names are snake_case via @map/@@map. That is the Postgres convention
// and it keeps the raw reconciliation SQL in the ledger module (Steps 31-32)
// readable without quoting every identifier.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A Cashping end user.
///
/// Registration is phone-first: the row is created in PENDING_VERIFICATION as
/// soon as an OTP is issued, and the profile fields are filled in during
/// onboarding, which is why `handle` and `displayName` are nullable. `handle` is
/// the recipient identifier used for payments, so it is unique.
///
/// `phoneNumber` holds strict E.164 only (normalized by
/// `src/common/phone/phone-number.ts` before every read and write). Uniqueness
/// is only meaningful if there is one spelling per number: `024 123 4567`,
/// `+233241234567` and `2330241234567` all reach the column as `+233241234567`,
/// which is why normalization happens before the lookup rather than after.
///
/// `phoneVerifiedAt` is the timestamp Day 2 keys off - Stellar account
/// provisioning triggers on it - so it is set in the same write that flips the
/// status to ACTIVE, and never cleared.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  phoneNumber     String     @unique @map("phone_number")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  handle          String?    @unique
  displayName     String?    @map("display_name")
  /// Nullable: MVP registration is OTP-only, so a user has no password until
  /// (and unless) password login is added. A non-null value is always a hash.
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(PENDING_VERIFICATION)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  otpVerifications     OtpVerification[]
  refreshTokens        RefreshToken[]
  stellarAccount       StellarAccount?
  sentTransactions     Transaction[]     @relation("SentTransactions")
  receivedTransactions Transaction[]     @relation("ReceivedTransactions")

  @@map("users")
}

/// One SMS one-time password issued to a user.
///
/// `codeHash` holds a hash, never the OTP itself - an OTP is a bearer
/// credential, so a database leak must not hand over live codes. `consumedAt`
/// makes a code single-use, `attempts` lets the verify path lock out after
/// repeated wrong guesses, and `expiresAt` turns the expired-OTP edge case
/// (Days 6-7) into a timestamp comparison rather than a cleanup job.
model OtpVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Supports "latest OTP for this user" lookups and per-user rate limiting.
  @@index([userId, createdAt])
  @@map("otp_verifications")
}

/// One issued refresh token (Step 16).
///
/// The counterpart to the access token, and the reason the pair exists: an access
/// token is a signed JWT the API verifies without a database read, which is also why
/// it cannot be withdrawn before it expires (a 15-minute life is the whole
/// mitigation). A refresh token makes the opposite trade - it is opaque, stored
/// here, and checked against a row, so it *can* be revoked, rotated and audited.
///
/// `tokenHash` holds a SHA-256 digest, never the token: a refresh token is a bearer
/// credential with a 30-day life, so a leaked database must not hand over working
/// sessions. The digest is unsalted on purpose - the input is 256 bits of CSPRNG
/// output, so unlike a 6-digit OTP there is nothing to brute-force, and a salted
/// hash would have to be looked up by something other than its index.
///
/// `revokedAt` is what makes rotation real: refreshing marks the token that was
/// presented and issues a new one, and a token that shows up again after that (a
/// stolen copy, or a replay) is evidence the family is compromised - which
/// `TokenService` treats as a reason to revoke every live token for the user.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Supports "every live token for this user", which is what reuse detection -
  /// and an eventual "sign out everywhere" - both need.
  @@index([userId, createdAt])
  @@map("refresh_tokens")
}

/// A user's Stellar account, and the only place key material lives (Step 18).
///
/// `userId` is unique because MVP derives exactly one account per user, once the
/// phone number is verified (Step 19). A second account is a multi-wallet product
/// decision, so it should take a migration rather than be silently allowed by the
/// schema.
///
/// `encryptedSecretKey` never holds a secret key. It holds the `cp-kms-1`
/// envelope: a per-account data key wrapped by the KMS master key, plus the seed
/// encrypted with that data key under AES-256-GCM. The column is useless without a
/// KMS `Decrypt` call, which is the property the Step 18 audit checks by reading
/// this table directly.
///
/// `dataKeyArn` records the master key that wrapped *this* row's data key. KMS
/// keys are regional and a key is referenced by an ARN, so a row must not have to
/// guess which key opens it - that reference is also what a future re-wrap
/// (`ReEncrypt`) or an audited rotation needs. No key id, wrapping key or data key
/// is stored in the clear anywhere.
///
/// `publicKey` is stored because it is what Horizon and every payment reference,
/// and it is public by definition. It is unique on the network, so a collision
/// here means something generated the same key twice - worth failing on.
///
/// The relation is `Restrict`, deliberately unlike the `Cascade` the auth models
/// use: deleting a user must not destroy sealed key material or silently orphan a
/// funded Stellar account, so deletion has to be a deliberate, audited act that
/// deals with the account first. `onDelete: Restrict` is what makes that the
/// only option.
model StellarAccount {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  publicKey          String   @unique @map("public_key")
  /// The `cp-kms-1` envelope (see `src/wallet/custody/secret-envelope.ts`).
  encryptedSecretKey String   @map("encrypted_secret_key")
  dataKeyArn         String   @map("data_key_arn")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("stellar_accounts")
}

/// One payment, from creation to settlement (Step 25).
///
/// `amount` is the first money column in the schema, and its type is the point: the
/// money rule (`src/common/money/money-discipline.ts`, importable as
/// `npm run lint:money`) fails the build on a money-named column typed `Float`,
/// `Real` or `DoublePrecision`, and `numeric(20, 7)` is what it prescribes. A float
/// column would lose the 7th decimal *at rest*, where no later code could recover
/// it - `test/money.e2e-spec.ts` writes the same crafted value to both and shows the
/// float one coming back changed. `Decimal(20, 7)` is Stellar's own fixed point:
/// seven decimals because a stroop is `0.0000001`, and twenty digits of width, which
/// leaves thirteen integer digits - room for the largest balance the network can
/// hold (`922337203685477.5807`, twelve integer digits) and every amount this API
/// will ever write into it.
///
/// The write always hands Prisma a *string* (`Amount.toString()`), which Prisma
/// parses to its own `Decimal` exactly - no JS `number` is involved in either
/// direction.
///
/// `status` is `PENDING` for every row this step writes, and stays that way until
/// Step 29's state machine moves it (see `TransactionStatus` for what the other
/// three values are for).
///
/// `idempotencyKey` is the client's key for this payment, and
/// `@@unique([senderId, idempotencyKey])` is what makes "one key, one payment" a
/// property of the database rather than of the application. The Redis record the
/// interceptor writes is the *fast* path - it is what lets a duplicate answer with
/// the original response instead of a second transaction - and this index is the net
/// under it: a lost or expired claim, a second API instance, a flush, a bug, and the
/// database still refuses the second row. The key is scoped per sender (not global)
/// because it is a client-generated nonce: two users may pick the same string, and
/// nothing about one user's key should constrain another's.
///
/// Both relations are `Restrict`, following `StellarAccount`'s reasoning: deleting a
/// user must not silently destroy payment history, so a user with transactions
/// cannot be deleted until those rows are dealt with deliberately. It also means a
/// test that registers senders has to delete its transactions *first*, which is the
/// honest order.
///
/// Step 27 added the four submission columns above - the submitted transaction's hash,
/// the sequence it consumed, the deadline the fence turns on, and the failure reason -
/// together with the unique index over the hash. What is still deliberately absent is
/// Step 28's poll bookkeeping (when the row was last polled, and how many times): it
/// arrives with the step that writes it, the same way every other model here grew.
model Transaction {
  id             String            @id @default(uuid()) @db.Uuid
  senderId       String            @map("sender_id") @db.Uuid
  recipientId    String            @map("recipient_id") @db.Uuid
  /// The money, as `numeric(20, 7)`: 13 integer digits - see this model's docblock.
  amount         Decimal           @db.Decimal(20, 7)
  status         TransactionStatus @default(PENDING)
  /// The client's `Idempotency-Key` for this payment, unique per sender.
  idempotencyKey String            @map("idempotency_key")
  /// The hash of the *signed* transaction this payment carries (Step 27).
  ///
  /// `NULL` until a transaction has been built and its hash committed; once written it
  /// is written *before* the signed transaction is handed to Horizon, so a submission
  /// that crashed mid-flight leaves a row that says "this transaction may exist" -
  /// the only reading that is safe to act on (see `PaymentsSubmissionService`).
  /// Horizon echoes the same hash back on acceptance, and it is the value an operator
  /// pastes into an explorer.
  ///
  /// Unique because a hash identifies exactly one transaction: two payments sharing
  /// one would mean one of them is not the payment it claims to be. Postgres treats
  /// `NULL`s as distinct, so the constraint applies only where a transaction exists.
  stellarTxHash      String?           @unique @map("stellar_tx_hash")
  /// The sequence number the built transaction consumed, as text (Step 27).
  ///
  /// A string, not a number, for the reason `StellarAccountSession` records about
  /// sequence numbers: a Stellar sequence is an int64 and `Number` silently rounds it
  /// above 2^53. The comparison the rebuild fence makes (`fresh === recorded`) is made
  /// with `BigInt` on this text. `varchar(20)` holds every int64 the network can issue
  /// (19 digits at most).
  stellarTxSequence  String?           @map("stellar_tx_sequence") @db.VarChar(20)
  /// The moment the recorded transaction stops being valid: its `maxTime` (Step 27).
  ///
  /// The fence's first half. While `now <= submissionDeadline` the recorded
  /// transaction might still land, so no second transaction may be built for this
  /// payment; only after it may a rebuild be considered, and then only if the fresh
  /// sequence number still matches `stellarTxSequence`.
  submissionDeadline DateTime?         @map("submission_deadline")
  /// Why this payment failed, as a short machine code (Step 27).
  ///
  /// `landed-unsuccessful:op_underfunded`, `submission-rejected:tx_bad_auth`,
  /// `secret-envelope:authentication-failed` - never Horizon's prose: an error body carries
  /// URLs and unbounded length, and this text is stored and rendered. `NULL` unless the
  /// status is `FAILED`.
  ///
  /// The two prefixes say **whether a ledger closed this transaction**, never which caller
  /// learned the outcome (Step 28's audit of Step 27's names):
  /// `landed-unsuccessful:<code>` is a transaction the ledger closed unsuccessfully - the
  /// fee is charged and the sequence consumed, which is why a `FAILED` row's hash is worth
  /// asking Horizon about rather than assuming it is absent - while
  /// `submission-rejected:<code>` is reserved for codes that are refusals about the
  /// envelope and were never in a ledger (`submission-triage.ts` holds that list, and its
  /// spec asserts the reservation over it). An unrecognised code gets no prefix at all.
  /// See `docs/step-28-29-proposal.md` §6 for the measurement behind the split.
  failureReason      String?           @map("failure_reason")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  sender    User @relation("SentTransactions", fields: [senderId], references: [id], onDelete: Restrict)
  recipient User @relation("ReceivedTransactions", fields: [recipientId], references: [id], onDelete: Restrict)

  /// One key, one payment: the structural half of Step 24's guarantee. See the
  /// docblock above - the Redis record is the fast path, this constraint is the net.
  @@unique([senderId, idempotencyKey])
  /// The overdraft check's index: "this sender's in-flight payments, summed".
  @@index([senderId, status])
  /// Step 30's history: one side of the list, newest first.
  @@index([recipientId, createdAt])
  @@map("transactions")
}

/// Where a payment is in its life (Steps 25 and 29).
///
/// Only `PENDING` is written today, and the value is named rather than numbered for
/// the reason the money rule exists: a status that is a number is a status whose
/// meaning a reader has to guess.
///
/// The other three are Day 4's, and they are declared here rather than in a later
/// migration because they are the *shape* of this column, not a feature of it - the
/// job that submits (Step 27) moves a row to `PROCESSING` and the job that polls
/// (Step 28) resolves it to `SUCCESSFUL` or to `FAILED`, and Step 29 puts a guard
/// around the transitions. Naming them now means Step 29's migration adds code, not
/// a column type - and it costs nothing, because nothing can write them until then.
enum TransactionStatus {
  /// Created and reserved against the sender's balance; nothing has been submitted.
  PENDING
  /// Submitted (or in flight) at the network; the outcome is not known yet.
  PROCESSING
  /// Horizon confirmed the transaction is in a closed ledger.
  SUCCESSFUL
  /// The network rejected it, or it failed on-ledger. The reason is a later column.
  FAILED
}

/// Account lifecycle.
///
/// `PENDING_VERIFICATION` is the state registration creates: the row exists and
/// an OTP has been issued, but the phone number is unproven. Verification moves
/// it to ACTIVE (Step 14). SUSPENDED exists from the start because freezing an
/// account is a compliance action, not something to bolt on later.
///
/// The default is deliberately PENDING_VERIFICATION rather than ACTIVE: a user
/// created by any path that forgets to prove the number is created locked, which
/// fails closed.
enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}
