# ---------------------------------------------------------------------------
# Cashping backend - environment template.
#
# Usage:  cp .env.example .env   and fill in real values.
#
# Every variable below is REQUIRED unless marked [optional]. The app validates
# this file during bootstrap and refuses to start if a required variable is
# missing or malformed, naming the offending variable(s) in the error - see
# src/config/validation.schema.ts.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# [optional] development | test | production   (default: development)
NODE_ENV=development
# [optional] Port the API listens on           (default: 3000)
PORT=3000

# --- Request body size -----------------------------------------------------
# [optional] Largest JSON request body the API will parse (default: 16kb).
# Anything larger is refused with a 413 before any controller or guard runs.
#
# 16kb is ~40x the biggest legitimate body this API accepts today - the password
# sign-in: a 254-character email plus a 128-character password is ~408 bytes - and
# 6.25x tighter than the 100 KB Express default the app ran with before this was
# made explicit. The value is a body-parser size: a byte count (65536) or a count
# with a unit (16kb, 1mb). A value that is not a byte size fails startup, naming
# BODY_LIMIT_JSON. Raise it only if a future endpoint genuinely needs larger
# bodies - never to let a request that is really a payload through.
BODY_LIMIT_JSON=16kb

# --- Interactive docs (Swagger UI) -----------------------------------------
# [optional] Serve the Swagger UI at /api/docs and the OpenAPI document at
# /api/docs-json (default: true).
#
# On locally because the docs are how the frontend team works against the API -
# and the API's own route prefix (/v1) is visible in them, so "Try it out" calls
# the real URL. Set ENABLE_SWAGGER=false in production: the surface is not a
# secret from the team, but publishing every endpoint plus a live "Try it out"
# console on a public host is an invitation nobody needs. docker-compose.yml
# defaults it to false for the same reason (that service runs NODE_ENV=production).
ENABLE_SWAGGER=true

# --- CORS (browser origins allowed to call the API) ------------------------
# [optional] Comma-separated origins, default
# http://localhost:3000,http://localhost:5173 (Next.js/CRA and Vite dev servers).
# No wildcard: the frontend is served from a known origin. Entries are compared
# literally against the browser's Origin header, so they must include the scheme
# and must not have a trailing slash or a path - the API refuses to boot on a
# value a browser would never send.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Payments queue --------------------------------------------------------
# [optional] How often the confirmation sweep polls Horizon for payments that
# are PROCESSING, in milliseconds (default: 0, which means "no schedule").
#
# 0 is the deliberate default: the sweep is a background process that writes
# payment verdicts, so a deployment switches it on rather than inheriting a
# timer. With it off, a payment stays PROCESSING until someone runs a tick -
# the README's Step 28 section has the one-liner.
#
# 5000 matches the Testnet ledger close time; polling faster mostly re-asks a
# question whose answer cannot have changed. The app validates this value at
# boot: an integer between 0 and 3600000.
PAYMENTS_CONFIRMATION_INTERVAL_MS=0

# --- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://cashping:cashping@localhost:5432/cashping?schema=public
# [optional] Host port docker-compose publishes Postgres on (default: 5432).
# Consumed by docker-compose.yml, not by the API. If a machine already runs its
# own Postgres it keeps the more specific 127.0.0.1 binding and shadows the
# container, so host-side tools (the Prisma CLI) silently reach the wrong server
# and fail with P1010 - bump this port here and in DATABASE_URL together.
POSTGRES_HOST_PORT=5432

# --- Redis -----------------------------------------------------------------
# Redis connection string (BullMQ queues, OTP rate limiting, idempotency keys).
REDIS_URL=redis://localhost:6379
# [optional] Host port docker-compose publishes Redis on (default: 6379).
# Same shadowing caveat as POSTGRES_HOST_PORT; keep it in step with REDIS_URL.
REDIS_HOST_PORT=6379

# --- Auth ------------------------------------------------------------------
# HMAC secret used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret

# --- Notifications (Africa's Talking) --------------------------------------
# API key from the Africa's Talking dashboard.
AFRICASTALKING_API_KEY=replace-me
# [optional] "sandbox" for the sandbox app, otherwise your live username.
#
# This also picks the API host: "sandbox" is served by
# api.sandbox.africastalking.com, any other username by api.africastalking.com.
# The sandbox key does not work on the live host (401), so the two must match.
AFRICASTALKING_USERNAME=sandbox
# [optional] Overrides the Africa's Talking host above. Only needed to point the
# client at a stub server in a test; must include the scheme.
# AFRICASTALKING_BASE_URL=https://api.sandbox.africastalking.com

# --- Notifications (Resend, email) -----------------------------------------
# API key from the Resend dashboard (resend.com -> API Keys). Required: it is the
# secret the email sender identifies the account by, so the API refuses to boot
# without it.
RESEND_API_KEY=re_replace-me
# [optional] The address email is sent *from*. Cashping's own sender, set here; the code
# default is Resend's shared test address (Cashping <onboarding@resend.dev>), which only
# delivers to the address the Resend account itself is registered under - enough to prove a
# real send works, and nothing more. Keep this on a @cashping.app address once that domain is
# verified in the Resend dashboard, and supply it from the deployment environment in production.
#
# When EMAIL_SENDER=sendgrid this must be the exact address verified under SendGrid's Single
# Sender Verification (see the SendGrid section below). When EMAIL_SENDER=smtp it must be the
# exact address verified as a sender in that relay (Brevo -> Senders, for example). Either relay
# refuses any other From, so the spelling here has to match the verified address exactly.
EMAIL_FROM=Cashping <no-reply@cashping.app>

# --- Notifications (email provider) ----------------------------------------
# [optional] Which email sender the app binds: resend | mailtrap | smtp | sendgrid
# (default: resend).
#
# resend sends real mail through the API key above. mailtrap hands every message to a Mailtrap
# "Email Testing" sandbox inbox instead - nothing reaches a real address, and no domain has to be
# verified - which is useful locally. smtp sends through a real relay (see below) and sendgrid
# through SendGrid's own relay (see below) so mail reaches arbitrary external inboxes without a
# verified Resend domain, which is what a staging environment wants. mailtrap is refused when
# NODE_ENV=production, because it would silently lose every code; resend, smtp and sendgrid are
# real senders and are allowed there.
# EMAIL_SENDER=mailtrap

# [optional] Mailtrap Email Testing SMTP settings (Mailtrap -> Email Testing -> Inbox -> SMTP
# settings). Read only when EMAIL_SENDER=mailtrap; the credentials are required then, and a send
# fails with a clear reason without them.
#
# The free Testing plan throttles to roughly one message per second and answers anything faster
# with SMTP 550 "Too many emails per second" - a plan limit, not a bug. Local use sends one
# message per user action, so it never notices; a burst (a test run firing several emails at
# once) will, and that send fails as a 503 rather than being retried.
# MAILTRAP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_PORT=2525
# MAILTRAP_USERNAME=replace-me
# MAILTRAP_PASSWORD=replace-me

# [optional] Generic SMTP relay settings. Read only when EMAIL_SENDER=smtp; all four are required
# then, and none has a default - there is no "the" SMTP server - so a missing value fails the send
# with a clear reason rather than connecting somewhere nobody chose.
#
# Brevo is the worked example: it verifies a single sender by email (no DNS/SPF/DKIM records
# needed) and offers port 2525, a non-standard SMTP port that hosting platforms do not block the
# way they sometimes block 25/465/587. The username is the Brevo login email and the password is
# the generated SMTP key (not the API key); host and port are the same for every account. Only 465
# is implicit TLS - 587 and 2525 upgrade with STARTTLS, which `SmtpEmailSender` sets for a non-465
# port. See https://developers.brevo.com/docs/smtp-integration.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=2525
# SMTP_USERNAME=replace-me
# SMTP_PASSWORD=replace-me
#
# Gmail also works over a 16-character app password (https://myaccount.google.com/apppasswords) on
# port 465, but Gmail rewrites `From` to the authenticated account and may hold the first send for
# review until its security alert is acknowledged, so it is not the staging recommendation.
# SMTP_HOST=smtp.gmail.com / SMTP_PORT=465

# --- Notifications (SendGrid, email) ---------------------------------------
# [optional] SendGrid API key. Read only when EMAIL_SENDER=sendgrid; required then, and absent
# from the code's defaults, so a send fails with a clear reason without it.
#
# SendGrid's SMTP relay is a fixed endpoint - smtp.sendgrid.net on port 587, authenticated as the
# literal user "apikey" - so those three are constants in the code and this key is the only
# setting. It reaches arbitrary external inboxes without a verified sending domain: SendGrid
# verifies one "from" address by email link (Settings -> Sender Authentication -> Single Sender
# Verification), and EMAIL_FROM above must be that exact address or the relay refuses the message.
# That is what a staging or development environment wants, where a domain verified in Resend
# (SPF/DKIM) is not available.
# SENDGRID_API_KEY=SG.replace-me

# --- Phone numbers ---------------------------------------------------------
# [optional] Region a national-format phone number is read against, as an ISO
# 3166-1 alpha-2 code (default: GH).
#
# Registration accepts any reasonable format and stores strict E.164 only. A
# number that carries its own country code (+2348031234567, 00233241234567) does
# not consult this; it decides how a leading-zero national number (0241234567)
# is interpreted. Wrong region = wrong number stored under a unique index, so
# the API refuses to boot on a code libphonenumber does not know.
PHONE_DEFAULT_REGION=GH

# --- Error reporting (Sentry) ----------------------------------------------
# DSN from your Sentry project: Settings -> Projects -> <project> -> Client Keys.
SENTRY_DSN=https://replace-me@o0.ingest.sentry.io/0
# [optional] Environment tag reported to Sentry (default: NODE_ENV).
SENTRY_ENVIRONMENT=development

# --- AWS / KMS (Stellar secret-key custody, Step 18) ------------------------
# The master key that wraps each account's data key, and the credentials allowed to
# use it. Every account's secret seed is encrypted under this key, so there is no
# working default: custody fails closed until a real key is configured, and the API's
# boot log says so.
#
# AWS_KMS_KEY_ID takes the forms AWS does: a key ARN, a bare key id
# (1234abcd-12ab-34cd-56ef-1234567890ab), or an alias (alias/cashping-seeds). The
# placeholder below is shape-valid on purpose - it boots, and then fails closed - so
# replace it with a real key before provisioning anything. It must be a key in
# AWS_REGION: KMS keys are regional, and a key from another region is invisible here
# (AWS reports that as NotFoundException, with no hint that the region is the problem).
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_KMS_KEY_ID=arn:aws:kms:eu-west-1:000000000000:key/00000000-0000-0000-0000-000000000000
#
# [optional] A non-AWS KMS endpoint. Unset, the SDK uses the regional endpoint derived
# from AWS_REGION. Set, every KMS call goes to this address instead, which is how a
# local emulator stands in for AWS - LocalStack publishes KMS on port 4566.
#
# Refused outright when NODE_ENV=production (see `validate` in
# src/config/validation.schema.ts): pointing custody at a non-AWS endpoint while
# AWS_KMS_KEY_ID still names an AWS key is a different trust boundary, not a
# convenience. Locally it also needs a real KMS on the other end: the master key has to
# exist in that emulator, with the same ARN shape.
# AWS_ENDPOINT_URL=http://localhost:4566

# --- Stellar ---------------------------------------------------------------
# TESTNET for local/dev, PUBLIC for production.
STELLAR_NETWORK=TESTNET
# Horizon endpoint matching STELLAR_NETWORK.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# [optional] Second Horizon endpoint for the same network, used as a fallback
# (default: http://localhost:8000, where a locally-run Stellar node - the
# stellar/quickstart container - publishes Horizon).
#
# Unused as of Step 17: the slot is wired into config so that pointing the
# failover at a real second host is a deployment change, not a code change. Plain
# http is accepted for loopback only; a remote fallback has to be https, because
# Horizon's answer is what decides whether a payment landed.
# STELLAR_HORIZON_FALLBACK_URL=http://localhost:8000
#
# Step 19. The USDC issuer every newly provisioned account is given a trustline for.
#
# Required, and a *key* rather than a code: an issuer is half of an asset's identity on
# Stellar, so `USDC:GBBD...` and `USDC:GDHU...` are two different assets that happen to
# share a code, and a wallet trusting the wrong one cannot be paid. It is per-network for
# the same reason: the value below is Circle's Testnet issuer, which does not exist on the
# public network - a `PUBLIC` deployment sets the mainnet issuer here (and funds accounts
# from a treasury rather than a faucet; see STELLAR_FRIENDBOT_URL).
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
#
# [optional] Where a brand-new account's first XLM comes from (default:
# https://friendbot.stellar.org/, Stellar's Testnet faucet). It must be a URL - a bare
# hostname would boot and then fail as a request-time TypeError - and it is a *funder*
# endpoint, called once per account with `?addr=<public key>`.
#
# There is no friendbot on the public network, which is why this is config and why
# production binds a treasury funder to the `ACCOUNT_FUNDER` token in `WalletModule`
# instead of changing this value. Leaving it pointing at a faucet on mainnet funds nothing
# and is refused as a misconfiguration at the first attempt, by name.
# STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org/
#
# [optional] Ceiling, in milliseconds, on one account's *whole* provisioning flow
# (default: 30000). Provisioning runs inside the request that verified the phone number,
# so this is the tail latency that request can add; the funder and each Horizon call have
# bounds of their own, and this is the one on the sequence, because the failure mode that
# matters is a series of calls each answering just inside its own limit.
# STELLAR_PROVISIONING_TIMEOUT_MS=30000
