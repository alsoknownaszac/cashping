# ---------------------------------------------------------------------------
# Cashping backend - environment template.
#
# Usage:  cp .env.example .env   and fill in real values.
#
# Every variable below is REQUIRED unless marked [optional]. The app validates
# this file during bootstrap and refuses to start if a required variable is
# missing or malformed, naming the offending variable(s) in the error - see
# src/config/validation.schema.ts.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# [optional] development | test | production   (default: development)
NODE_ENV=development
# [optional] Port the API listens on           (default: 3000)
PORT=3000

# --- Interactive docs (Swagger UI) -----------------------------------------
# [optional] Serve the Swagger UI at /api/docs and the OpenAPI document at
# /api/docs-json (default: true).
#
# On locally because the docs are how the frontend team works against the API -
# and the API's own route prefix (/v1) is visible in them, so "Try it out" calls
# the real URL. Set ENABLE_SWAGGER=false in production: the surface is not a
# secret from the team, but publishing every endpoint plus a live "Try it out"
# console on a public host is an invitation nobody needs. docker-compose.yml
# defaults it to false for the same reason (that service runs NODE_ENV=production).
ENABLE_SWAGGER=true

# --- CORS (browser origins allowed to call the API) ------------------------
# [optional] Comma-separated origins, default
# http://localhost:3000,http://localhost:5173 (Next.js/CRA and Vite dev servers).
# No wildcard: the frontend is served from a known origin. Entries are compared
# literally against the browser's Origin header, so they must include the scheme
# and must not have a trailing slash or a path - the API refuses to boot on a
# value a browser would never send.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://cashping:cashping@localhost:5432/cashping?schema=public
# [optional] Host port docker-compose publishes Postgres on (default: 5432).
# Consumed by docker-compose.yml, not by the API. If a machine already runs its
# own Postgres it keeps the more specific 127.0.0.1 binding and shadows the
# container, so host-side tools (the Prisma CLI) silently reach the wrong server
# and fail with P1010 - bump this port here and in DATABASE_URL together.
POSTGRES_HOST_PORT=5432

# --- Redis -----------------------------------------------------------------
# Redis connection string (BullMQ queues, OTP rate limiting, idempotency keys).
REDIS_URL=redis://localhost:6379
# [optional] Host port docker-compose publishes Redis on (default: 6379).
# Same shadowing caveat as POSTGRES_HOST_PORT; keep it in step with REDIS_URL.
REDIS_HOST_PORT=6379

# --- Auth ------------------------------------------------------------------
# HMAC secret used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret

# --- Notifications (Africa's Talking) --------------------------------------
# API key from the Africa's Talking dashboard.
AFRICASTALKING_API_KEY=replace-me
# [optional] "sandbox" for the sandbox app, otherwise your live username.
#
# This also picks the API host: "sandbox" is served by
# api.sandbox.africastalking.com, any other username by api.africastalking.com.
# The sandbox key does not work on the live host (401), so the two must match.
AFRICASTALKING_USERNAME=sandbox
# [optional] Overrides the Africa's Talking host above. Only needed to point the
# client at a stub server in a test; must include the scheme.
# AFRICASTALKING_BASE_URL=https://api.sandbox.africastalking.com

# --- Phone numbers ---------------------------------------------------------
# [optional] Region a national-format phone number is read against, as an ISO
# 3166-1 alpha-2 code (default: GH).
#
# Registration accepts any reasonable format and stores strict E.164 only. A
# number that carries its own country code (+2348031234567, 00233241234567) does
# not consult this; it decides how a leading-zero national number (0241234567)
# is interpreted. Wrong region = wrong number stored under a unique index, so
# the API refuses to boot on a code libphonenumber does not know.
PHONE_DEFAULT_REGION=GH

# --- Error reporting (Sentry) ----------------------------------------------
# DSN from your Sentry project: Settings -> Projects -> <project> -> Client Keys.
SENTRY_DSN=https://replace-me@o0.ingest.sentry.io/0
# [optional] Environment tag reported to Sentry (default: NODE_ENV).
SENTRY_ENVIRONMENT=development

# --- AWS / KMS (Stellar secret-key custody) --------------------------------
# Credentials and KMS key used to encrypt/decrypt Stellar secret seeds.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_KMS_KEY_ID=replace-me

# --- Stellar ---------------------------------------------------------------
# TESTNET for local/dev, PUBLIC for production.
STELLAR_NETWORK=TESTNET
# Horizon endpoint matching STELLAR_NETWORK.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
